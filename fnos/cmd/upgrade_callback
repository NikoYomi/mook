#!/bin/bash
#
# Mook · 升级后执行（upgrade_callback）
#
# 在新版应用包落盘之后调用。
#
# 这里必须显式重建容器，原因：
#   容器由 fnOS 依据 config/resource 的 docker-project 启动，但当 compose 文件
#   本身发生变化（端口映射、镜像标签）时，仅靠 `docker pull` 不会让既有容器
#   换用新配置 —— 实测表现为「应用中心显示新版，容器里跑的仍是旧版」。
#   因此这里主动 up -d --force-recreate 一次，确保 compose 变更真正生效。
#
# 数据库位于 ${TRIM_PKGVAR}/data（宿主机卷），重建容器不影响用户数据。
#
# 退出码约定：
#   0 = 成功
#   1 = 失败

set -u

LOG="${TRIM_TEMP_LOGFILE:-/dev/null}"
IMAGE="nikoyomi/mook:latest"
CONTAINER_NAME="mook-fnos"

log() {
  echo "[mook][upgrade_callback] $*" >> "$LOG" 2>/dev/null || true
}

log "升级完成，开始更新镜像与容器"

if ! command -v docker >/dev/null 2>&1; then
  log "警告: 未检测到 docker 命令，跳过（fnOS 将在启动阶段处理）"
  exit 0
fi

if docker pull "$IMAGE" >> "$LOG" 2>&1; then
  log "新镜像就绪: $IMAGE"
else
  log "警告: 镜像拉取失败，将在启动阶段重试"
fi

# 仅在 compose 文件可用时重建；否则交由 fnOS 的启动流程处理。
COMPOSE_FILE="${TRIM_APPDEST:-}/docker/docker-compose.yaml"
if [ -f "$COMPOSE_FILE" ]; then
  log "重建容器以应用新的 compose 配置: $CONTAINER_NAME"

  # 复用向导变量，保证端口映射与安装时选择的一致。
  export mook_web_port="${mook_web_port:-5866}"

  docker compose -f "$COMPOSE_FILE" --project-name mook up -d --force-recreate >> "$LOG" 2>&1 \
    || log "警告: compose 重建失败，fnOS 将在启动阶段重试"
else
  log "警告: 未找到 compose 文件: $COMPOSE_FILE，跳过重建"
fi

log "用户数据目录保持不变: ${TRIM_PKGVAR:-<未设置>}/data"
exit 0
